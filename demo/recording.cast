[9.891399, "o", "\r\n  \u001b[2mAs expected — the device speaks NETCONF (SSH), not gRPC.\u001b[0m\r\n"]
[10.39365, "o", "  \u001b[2mgnmic has no way to talk to it. That's what the bridge fixes.\u001b[0m\r\n"]
[12.899523, "o", "\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;34m  ACT 2: The Solution — Lumentum ROADM (192.0.2.17) → gNMI :9341\u001b[0m\r\n"]
