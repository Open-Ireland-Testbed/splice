{"version": 2, "width": 150, "height": 40, "timestamp": 1773613401, "idle_time_limit": 3.0, "env": {"SHELL": "/usr/bin/zsh", "TERM": "tmux-256color"}, "title": "Splice: Multi-Vendor Demo"}
[0.022836, "o", "\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;34m  Splice — Multi-Vendor Demo\u001b[0m\r\n"]
[0.023934, "o", "\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[1.025851, "o", "  Three optical network devices, three different vendors.\r\n  None of them speak gNMI. All of them speak NETCONF.\r\n\r\n    \u001b[0;36m1.\u001b[0m Lumentum ROADM     \u001b[2m(192.0.2.17)\u001b[0m\r\n    \u001b[0;36m2.\u001b[0m Adtran Teraflex    \u001b[2m(192.0.2.92)\u001b[0m\r\n    \u001b[0;36m3.\u001b[0m Juniper ILA        \u001b[2m(192.0.2.20)\u001b[0m\r\n\r\n"]
[1.025947, "o", "  The bridge translates NETCONF → gNMI so standard telemetry\r\n  collectors (gnmic, Telegraf, etc.) can subscribe to them.\r\n"]
[4.029199, "o", "\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;34m  ACT 1: The Problem — gnmic can't talk to NETCONF devices\u001b[0m\r\n"]
[4.029292, "o", "\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
