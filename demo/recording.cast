[88.132552, "o", "\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;34m  ACT 5: Live PM Data — Real Coherent Transport Telemetry\u001b[0m\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[89.13826, "o", "  The Teraflex is a coherent transponder on a real optical link:\r\n\r\n    \u001b[0;36mTeraflex → ROADM → 25km fiber → ILA → ROADM → Teraflex\u001b[0m\r\n"]
[89.138347, "o", "\r\n  \u001b[2mPulling live PM data — Q-factor, OSNR, FEC-BER...\u001b[0m\r\n"]
[89.641409, "o", "  \u001b[2mWaiting for at least one PM polling cycle...\u001b[0m\r\n"]
