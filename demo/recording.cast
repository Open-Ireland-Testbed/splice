[36.857627, "o", "\r\n\u001b[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;34m  ACT 3: Scale — Three Vendors, One Interface\u001b[0m\r\n"]
